# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# AI provider (one of the following)
# 1) Direct Anthropic API (preferred when set)
ANTHROPIC_API_KEY=
# Model used for interpretation (direct Anthropic)
ANTHROPIC_MODEL=claude-sonnet-5-5

# 2) Vercel AI Gateway (used automatically on Vercel if no ANTHROPIC_API_KEY;
#    uses OIDC token on Vercel deployments, or set AI_GATEWAY_API_KEY locally)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_FAST_MODEL=anthropic/claude-haiku-5.5

# Server credential — sha256 of this value must be stored in
# arcana_server_config.server_secret_sha256 (see README)
ARCANA_SERVER_SECRET=

# Payments (optional). Without STRIPE_SECRET_KEY credit purchases are disabled.
# Use sk_test_... first. The webhook endpoint is /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator access key for /admin/login (owner-level, local reference only).
# The app does not read this variable: only its sha256 is stored in
# arcana_server_config.admin_key_sha256.
ARCANA_ADMIN_KEY=

# Google Search Console ownership (optional): the token from the HTML-tag method.
GOOGLE_SITE_VERIFICATION=

# Slip verification for PromptPay transfers (optional). Without these every
# transfer waits for an admin to approve it in Admin → Payments.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# Automatic PromptPay QR through Beam Checkout (optional): scan, pay, done — no
# slip. Keys from Beam Lighthouse → Developers. BEAM_ENV=production for real
# money; anything else uses the playground and is offered to admins only.
# Webhook URL in Beam: https://<your-domain>/api/billing/beam/webhook (charge.succeeded)
BEAM_MERCHANT_ID=
BEAM_API_KEY=
BEAM_WEBHOOK_KEY=
BEAM_ENV=

# Vercel Cron bearer for /api/cron/daily (any random string, 16+ characters)
CRON_SECRET=

# Owner notifications when a customer reports a transfer (optional; either or both).
# LINE: Messaging API channel access token + the owner's own user id.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
# Telegram: bot token from @BotFather + the chat id to send to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
