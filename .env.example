# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# AI provider (one of the following)
# 1) Direct Anthropic API (preferred when set)
ANTHROPIC_API_KEY=
# Model used for interpretation (direct Anthropic)
ANTHROPIC_MODEL=claude-sonnet-5-5

# 2) Vercel AI Gateway (used automatically on Vercel if no ANTHROPIC_API_KEY;
#    uses OIDC token on Vercel deployments, or set AI_GATEWAY_API_KEY locally)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_FAST_MODEL=anthropic/claude-haiku-5.5

# Server credential — sha256 of this value must be stored in
# arcana_server_config.server_secret_sha256 (see README)
ARCANA_SERVER_SECRET=
